  object ctDist: TChartToolset
    Left = 244
    Top = 160
    object ctCrosshair: TDataPointCrosshairTool
      OnAfterMouseMove = ctCrosshairAfterMouseMove
      GrabRadius = 1600
      OnDraw = ctCrosshairDraw
      CrosshairPen.Color = clMaroon
      CrosshairPen.Style = psDashDotDot
      Shape = ccsNone
      Size = 1600
    end
    object Drag: TDataPointDistanceTool
      Shift = [ssLeft]
      OnAfterMouseMove = DragAfterMouseMove
      OnBeforeKeyDown = DragBeforeKeyDown
      OnBeforeKeyUp = DragBeforeKeyUp
      OnBeforeMouseMove = DragBeforeMouseMove
      DrawingMode = tdmNormal
      LinePen.Width = 2
      Marks.Distance = 30
      Marks.Format = 'dist='#13#10'%0:.9g / %1:.9g'
      Marks.LabelBrush.Color = clSkyBlue
      Marks.LinkPen.Color = clBlue
      Options = [dpdoPermanent]
      PointerEnd.Brush.Style = bsClear
      PointerEnd.VertSize = 1000
      PointerEnd.Visible = True
      PointerStart.Brush.Style = bsClear
      PointerStart.Pen.Color = clRed
      PointerStart.VertSize = 1000
      PointerStart.Visible = True
      OnMeasure = DragMeasure
    end
    object Ctrl_Drag: TDataPointDistanceTool
      Shift = [ssCtrl, ssLeft]
      DrawingMode = tdmNormal
      Marks.Format = '%0:.9g'
      Options = [dpdoPermanent]
      PointerEnd.HorizSize = 8
      PointerEnd.Style = psRightTriangle
      PointerEnd.VertSize = 8
      PointerEnd.Visible = True
      PointerStart.Brush.Style = bsClear
      PointerStart.Style = psLeftBracket
      PointerStart.VertSize = 8
      PointerStart.Visible = True
      OnMeasure = Ctrl_DragMeasure
    end
    object ctDistPanMouseWheelTool1: TPanMouseWheelTool
    end
  end
  object ListChartSource6: TListChartSource
    DataPoints.Strings = (
