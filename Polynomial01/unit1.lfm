  object ChartForceManual: TChart
    AnchorSideLeft.Control = Owner
    AnchorSideTop.Control = Memo1
    AnchorSideTop.Side = asrBottom
    AnchorSideRight.Control = Owner
    AnchorSideRight.Side = asrBottom
    AnchorSideBottom.Control = StatusBar1
    Left = 0
    Height = 258
    Top = 239
    Width = 575
    AntialiasingMode = amOn
    AxisList = <    
      item
        Marks.LabelBrush.Style = bsClear
        Minors = <>
        Range.Max = 100
        Title.LabelFont.Orientation = 900
        Title.LabelBrush.Style = bsClear
      end    
      item
        Grid.Visible = False
        Alignment = calBottom
        Marks.LabelFont.Orientation = 900
        Marks.Format = '%2:s'
        Marks.LabelBrush.Style = bsClear
        Marks.OverlapPolicy = opHideNeighbour
        Marks.Source = ListChartSource5
        Marks.Style = smsLabel
        Minors = <>
        Range.Max = 60
        Range.UseMax = True
        Range.UseMin = True
        Title.Caption = 'Time Date'
        Title.LabelBrush.Style = bsClear
      end>
    Extent.UseYMax = True
    Extent.UseYMin = True
    Extent.XMax = 60
    Extent.YMax = 100
    Foot.Brush.Color = clBtnFace
    Foot.Font.Color = clBlue
    Foot.Frame.Visible = True
    Foot.Shape = clsUserDefined
    Title.Brush.Color = clBtnFace
    Title.Font.Color = clBlue
    Title.Text.Strings = (
      'TAChart'
    )
    Toolset = ctDist
    OnBeforeDrawBackground = ChartForceManualBeforeDrawBackground
    OnBeforeDrawBackWall = ChartForceManualBeforeDrawBackWall
    Anchors = [akTop, akLeft, akRight, akBottom]
    PopupMenu = PopupMenu1
    OnMouseMove = ChartForceManualMouseMove
